{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "grit",
  "version": "0.4.2",
  "identifier": "io.grit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "grit",
        "width": 1320,
        "height": 840,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A cross-platform interactive Git client",
    "longDescription": "grit is a fast, cross-platform Git client. Stage and unstage files, review diffs, commit and amend, browse the history with a branch graph, and check out branches. It runs the installed git executable, so hooks, credentials, SSH and commit signing behave exactly like on the command line.",
    "copyright": "Copyright (c) 2026 Sascha Raesch",
    "license": "MIT",
    "licenseFile": "../LICENSE"
  }
}
